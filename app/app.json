{
  "expo": {
    "name": "Cliffword",
    "slug": "cliffword",
    "owner": "greypebs",
    "scheme": "cliffword",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F4F1",
    "ios": {
      "bundleIdentifier": "app.cliffword",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cliffword uses the microphone while you hold to speak, so it can hear your answers to the story and the lines you sing back.",
        "NSSpeechRecognitionUsageDescription": "Cliffword turns what you say into text so it can check your answers and show which words were unexpected.",
        "NSAppleMusicUsageDescription": "Cliffword plays songs from your Apple Music library and pauses them at a line so you can say or sing it back.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.cliffword",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#F3F4F1"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_PHONE_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.gms.permission.AD_ID"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#F3F4F1"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F4F1"
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/newsreader/400Regular/Newsreader_400Regular.ttf",
              "./node_modules/@expo-google-fonts/newsreader/500Medium/Newsreader_500Medium.ttf",
              "./node_modules/@expo-google-fonts/newsreader/600SemiBold/Newsreader_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
              "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
              "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
              "./node_modules/@expo-google-fonts/anton/400Regular/Anton_400Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Newsreader-Regular",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/newsreader/400Regular/Newsreader_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Newsreader-Medium",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/newsreader/500Medium/Newsreader_500Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Newsreader-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/newsreader/600SemiBold/Newsreader_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Inter-Regular",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Inter-Medium",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Inter-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Inter-Bold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Anton-Regular",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/anton/400Regular/Anton_400Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cliffword uses the microphone while you hold to speak, so it can hear your answers to the story and the lines you sing back.",
          "speechRecognitionPermission": "Cliffword turns what you say into text so it can check your answers and show which words were unexpected.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Cliffword Share",
          "iosShareExtensionBundleIdentifier": "app.cliffword.share-extension",
          "iosAppGroupIdentifier": "group.app.cliffword",
          "androidIntentFilters": [
            "text/plain"
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      "./modules/cliffword-native/app.plugin.js",
      [
        "./plugins/withAndroidBuildTuning",
        {
          "properties": {
            "reactNativeArchitectures": "arm64-v8a",
            "rnllamaVariants": "rnllama,rnllama_v8_2_dotprod,rnllama_v8_2_dotprod_i8mm"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13fc6e30-3463-4c2f-9efe-cebdd3356ed7"
      }
    }
  }
}
