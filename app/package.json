{
  "name": "cliffword-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@cliffword/engine": "file:../engine",
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-share-intent": "^9.0.0",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "llama.rn": "0.13.0-rc.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check": "npm run typecheck && npm test",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:android": "expo export --platform android --output-dir dist-android",
    "doctor": "npx --yes expo-doctor",
    "icons": "node scripts/make-icons.js",
    "screenshots": "node scripts/store-screenshots.js --build",
    "postinstall": "patch-package",
    "patch:llama.rn": "patch-package llama.rn --exclude '^package\\.json$|^ios/rnllama\\.xcframework/|^android/src/main/jniLibs/'"
  },
  "private": true
}
