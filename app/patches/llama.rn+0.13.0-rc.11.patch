diff --git a/node_modules/llama.rn/cpp/jsi/CliffwordScore.cpp b/node_modules/llama.rn/cpp/jsi/CliffwordScore.cpp
new file mode 100644
index 0000000..22390a7
--- /dev/null
+++ b/node_modules/llama.rn/cpp/jsi/CliffwordScore.cpp
@@ -0,0 +1,352 @@
+// Cliffword (patch-package): see CliffwordScore.h.
+#include "CliffwordScore.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace cliffword {
+
+namespace {
+
+thread_local EvalStats g_stats;
+
+void clear_memory(llama_context * ctx, EvalState & state) {
+    llama_memory_t mem = llama_get_memory(ctx);
+    if (mem != nullptr) {
+        llama_memory_clear(mem, false);
+    }
+    state.tokens.clear();
+    state.clean = 0;
+}
+
+// log(sum(exp(row))) in double, the way numpy computes it in model_server.py.
+double log_sum_exp(const float * row, int32_t n) {
+    double m = -std::numeric_limits<double>::infinity();
+    for (int32_t i = 0; i < n; ++i) {
+        if ((double) row[i] > m) m = (double) row[i];
+    }
+    if (!std::isfinite(m)) {
+        return m;
+    }
+    double s = 0.0;
+    for (int32_t i = 0; i < n; ++i) {
+        s += std::exp((double) row[i] - m);
+    }
+    return m + std::log(s);
+}
+
+const llama_vocab * vocab_of(llama_context * ctx) {
+    const llama_model * model = llama_get_model(ctx);
+    if (model == nullptr) {
+        throw std::runtime_error("cliffword: context has no model");
+    }
+    return llama_model_get_vocab(model);
+}
+
+// Evaluates `tokens` in seq 0 and calls on_row(pos, logits) for every position in
+// [first_row, end_row), in order. Row `pos` holds the logits that predict tokens[pos + 1].
+//
+// The memory keeps the longest clean prefix shared with the previous evaluation (so scoring
+// several texts after one context evaluates the context once), but never past first_row,
+// whose logits must be computed now, and never so far that fewer than kMinBatch tokens are
+// left to evaluate. The sequence is decoded in chunks of min(n_batch, n_ubatch) tokens; a
+// trailing one-token chunk is avoided by moving a token into it from the chunk before. Only
+// positions evaluated in chunks of at least kMinBatch tokens count as clean afterwards, so a
+// reused prefix never changes a score: the result is the same whatever ran before.
+template <typename OnRow>
+void evaluate(llama_context * ctx, EvalState & state, const std::vector<llama_token> & tokens,
+              size_t first_row, size_t end_row, OnRow && on_row) {
+    const size_t n = tokens.size();
+    if (n == 0 || first_row >= end_row || end_row > n) {
+        throw std::logic_error("cliffword: bad evaluation range");
+    }
+    const size_t n_ctx = llama_n_ctx_seq(ctx);
+    if (n > n_ctx) {
+        throw std::runtime_error("cliffword: " + std::to_string(n) +
+                                 " tokens do not fit the context window of " + std::to_string(n_ctx));
+    }
+
+    size_t common = 0;
+    const size_t lim = std::min(std::min(state.clean, state.tokens.size()), n);
+    while (common < lim && state.tokens[common] == tokens[common]) {
+        ++common;
+    }
+    size_t start = std::min(common, first_row);
+    start = std::min(start, n >= kMinBatch ? n - kMinBatch : (size_t) 0);
+
+    llama_memory_t mem = llama_get_memory(ctx);
+    if (mem == nullptr) {
+        throw std::runtime_error("cliffword: context has no memory");
+    }
+    // Drop everything of seq 0 from `start` on. A recurrent model cannot drop part of a
+    // sequence: start over.
+    if (!llama_memory_seq_rm(mem, 0, (llama_pos) start, -1)) {
+        clear_memory(ctx, state);
+        start = 0;
+    }
+    // Until the decode below succeeds, the memory holds tokens[0, start) only.
+    state.tokens.assign(tokens.begin(), tokens.begin() + (std::ptrdiff_t) start);
+    state.clean = std::min(state.clean, start);
+
+    size_t chunk = std::min<size_t>(llama_n_batch(ctx), llama_n_ubatch(ctx));
+    if (chunk == 0) chunk = 1;
+    std::vector<size_t> bounds;  // chunk end positions
+    for (size_t b = start; b < n;) {
+        b = std::min(n, b + chunk);
+        bounds.push_back(b);
+    }
+    if (bounds.size() >= 2) {
+        const size_t last = bounds.back() - bounds[bounds.size() - 2];
+        const size_t prev_begin = bounds.size() >= 3 ? bounds[bounds.size() - 3] : start;
+        const size_t prev = bounds[bounds.size() - 2] - prev_begin;
+        if (last < kMinBatch && prev > kMinBatch) {
+            bounds[bounds.size() - 2] -= 1;
+        }
+    }
+
+    size_t clean = start;
+    size_t begin = start;
+    for (size_t end : bounds) {
+        const int32_t len = (int32_t) (end - begin);
+        llama_batch batch = llama_batch_init(len, 0, 1);
+        for (int32_t i = 0; i < len; ++i) {
+            const size_t pos = begin + (size_t) i;
+            batch.token[i] = tokens[pos];
+            batch.pos[i] = (llama_pos) pos;
+            batch.n_seq_id[i] = 1;
+            batch.seq_id[i][0] = 0;
+            batch.logits[i] = (pos >= first_row && pos < end_row) ? 1 : 0;
+        }
+        batch.n_tokens = len;
+        const int32_t rc = llama_decode(ctx, batch);
+        if (rc != 0) {
+            llama_batch_free(batch);
+            clear_memory(ctx, state);
+            throw std::runtime_error("cliffword: llama_decode failed with code " + std::to_string(rc) +
+                                     " at positions " + std::to_string(begin) + ".." + std::to_string(end));
+        }
+        try {
+            for (int32_t i = 0; i < len; ++i) {
+                if (!batch.logits[i]) continue;
+                const float * row = llama_get_logits_ith(ctx, i);
+                if (row == nullptr) {
+                    throw std::runtime_error("cliffword: the context computes no logits (embedding mode?)");
+                }
+                on_row(begin + (size_t) i, row);
+            }
+        } catch (...) {
+            llama_batch_free(batch);
+            clear_memory(ctx, state);
+            throw;
+        }
+        llama_batch_free(batch);
+        state.tokens.insert(state.tokens.end(), tokens.begin() + (std::ptrdiff_t) begin,
+                            tokens.begin() + (std::ptrdiff_t) end);
+        if ((size_t) len >= kMinBatch && clean == begin) {
+            clean = end;
+        }
+        begin = end;
+    }
+    state.clean = clean;
+    g_stats.reused_tokens = start;
+    g_stats.evaluated_tokens = n - start;
+}
+
+} // namespace
+
+std::vector<llama_token> tokenize(const llama_vocab * vocab, const std::string & text) {
+    if (text.empty()) {
+        return {};
+    }
+    std::vector<llama_token> out(text.size() + 2);
+    int32_t n = llama_tokenize(vocab, text.data(), (int32_t) text.size(), out.data(),
+                               (int32_t) out.size(), /*add_special=*/false, /*parse_special=*/false);
+    if (n == std::numeric_limits<int32_t>::min()) {
+        throw std::runtime_error("cliffword: text too long to tokenize");
+    }
+    if (n < 0) {
+        out.resize((size_t) -n);
+        n = llama_tokenize(vocab, text.data(), (int32_t) text.size(), out.data(),
+                           (int32_t) out.size(), false, false);
+        if (n < 0) {
+            throw std::runtime_error("cliffword: tokenization failed");
+        }
+    }
+    out.resize((size_t) n);
+    return out;
+}
+
+std::vector<llama_token> start_tokens(const llama_vocab * vocab) {
+    llama_token buf[8];
+    const int32_t n = llama_tokenize(vocab, "", 0, buf, 8, /*add_special=*/true, /*parse_special=*/false);
+    if (n > 0) {
+        return std::vector<llama_token>(buf, buf + n);
+    }
+    const llama_token eos = llama_vocab_eos(vocab);
+    if (eos == LLAMA_TOKEN_NULL) {
+        throw std::runtime_error("cliffword: the model has neither a BOS nor an EOS token");
+    }
+    return {eos};
+}
+
+std::string token_piece(const llama_vocab * vocab, llama_token token) {
+    std::string piece(16, '\0');
+    int32_t n = llama_token_to_piece(vocab, token, &piece[0], (int32_t) piece.size(), 0, /*special=*/false);
+    if (n < 0) {
+        piece.resize((size_t) -n);
+        n = llama_token_to_piece(vocab, token, &piece[0], (int32_t) piece.size(), 0, false);
+        if (n < 0) {
+            throw std::runtime_error("cliffword: token_to_piece failed");
+        }
+    }
+    piece.resize((size_t) n);
+    return piece;
+}
+
+bool is_complete_utf8(const std::string & bytes) {
+    const auto * p = reinterpret_cast<const unsigned char *>(bytes.data());
+    const size_t n = bytes.size();
+    size_t i = 0;
+    while (i < n) {
+        const unsigned c = p[i];
+        if (c < 0x80) {
+            ++i;
+            continue;
+        }
+        size_t len = 0;
+        unsigned lo = 0x80, hi = 0xBF;  // allowed range of the second byte
+        if (c >= 0xC2 && c <= 0xDF) {
+            len = 2;
+        } else if (c == 0xE0) {
+            len = 3; lo = 0xA0;            // no overlongs
+        } else if ((c >= 0xE1 && c <= 0xEC) || c == 0xEE || c == 0xEF) {
+            len = 3;
+        } else if (c == 0xED) {
+            len = 3; hi = 0x9F;            // no surrogates
+        } else if (c == 0xF0) {
+            len = 4; lo = 0x90;            // no overlongs
+        } else if (c >= 0xF1 && c <= 0xF3) {
+            len = 4;
+        } else if (c == 0xF4) {
+            len = 4; hi = 0x8F;            // nothing above U+10FFFF
+        } else {
+            return false;                  // continuation byte, C0, C1 or F5..FF
+        }
+        if (i + len > n) {
+            return false;
+        }
+        if (p[i + 1] < lo || p[i + 1] > hi) {
+            return false;
+        }
+        for (size_t j = 2; j < len; ++j) {
+            if (p[i + j] < 0x80 || p[i + j] > 0xBF) {
+                return false;
+            }
+        }
+        i += len;
+    }
+    return true;
+}
+
+std::vector<ScoredToken> score_text(llama_context * ctx, EvalState & state,
+                                    const std::string & context, const std::string & text) {
+    g_stats = EvalStats{};
+    if (text.empty()) {
+        return {};
+    }
+    const llama_vocab * vocab = vocab_of(ctx);
+    std::vector<llama_token> all = start_tokens(vocab);
+    const std::vector<llama_token> ctx_tokens = tokenize(vocab, context);
+    all.insert(all.end(), ctx_tokens.begin(), ctx_tokens.end());
+    const size_t n_prefix = all.size();
+    const std::vector<llama_token> text_tokens = tokenize(vocab, text);
+    if (text_tokens.empty()) {
+        throw std::runtime_error("cliffword: the text has no tokens");
+    }
+    all.insert(all.end(), text_tokens.begin(), text_tokens.end());
+    g_stats.prefix_tokens = n_prefix;
+
+    // Byte ranges of the pieces; they must spell the text exactly.
+    std::vector<ScoredToken> out(text_tokens.size());
+    size_t off = 0;
+    for (size_t j = 0; j < text_tokens.size(); ++j) {
+        const std::string piece = token_piece(vocab, text_tokens[j]);
+        if (text.compare(off, piece.size(), piece) != 0) {
+            throw std::runtime_error("cliffword: token pieces do not spell the text");
+        }
+        out[j] = ScoredToken{text_tokens[j], off, off + piece.size(), 0.0};
+        off += piece.size();
+    }
+    if (off != text.size()) {
+        throw std::runtime_error("cliffword: token pieces do not cover the text");
+    }
+
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+    evaluate(ctx, state, all, n_prefix - 1, all.size() - 1, [&](size_t pos, const float * row) {
+        const size_t j = pos - (n_prefix - 1);
+        out[j].logprob = (double) row[out[j].id] - log_sum_exp(row, n_vocab);
+    });
+    return out;
+}
+
+std::vector<NextToken> next_tokens(llama_context * ctx, EvalState & state,
+                                   const std::string & context, int k) {
+    g_stats = EvalStats{};
+    if (k <= 0) {
+        return {};
+    }
+    const llama_vocab * vocab = vocab_of(ctx);
+    std::vector<llama_token> all = start_tokens(vocab);
+    const std::vector<llama_token> ctx_tokens = tokenize(vocab, context);
+    all.insert(all.end(), ctx_tokens.begin(), ctx_tokens.end());
+    g_stats.prefix_tokens = all.size();
+
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+    std::vector<double> lsm((size_t) n_vocab);
+    evaluate(ctx, state, all, all.size() - 1, all.size(), [&](size_t, const float * row) {
+        const double lse = log_sum_exp(row, n_vocab);
+        for (int32_t i = 0; i < n_vocab; ++i) {
+            lsm[(size_t) i] = (double) row[i] - lse;
+        }
+    });
+
+    // Most likely first; ties by token id. Widen the sorted head until k usable tokens are
+    // found (skipped pieces do not count) or the whole vocabulary has been looked at.
+    std::vector<llama_token> idx((size_t) n_vocab);
+    std::iota(idx.begin(), idx.end(), 0);
+    const auto more_likely = [&lsm](llama_token a, llama_token b) {
+        const double x = lsm[(size_t) a], y = lsm[(size_t) b];
+        if (x != y) return x > y;
+        return a < b;
+    };
+    size_t width = std::min<size_t>((size_t) n_vocab, 2 * (size_t) k + 16);
+    std::vector<NextToken> out;
+    while (true) {
+        std::partial_sort(idx.begin(), idx.begin() + (std::ptrdiff_t) width, idx.end(), more_likely);
+        out.clear();
+        for (size_t i = 0; i < width && out.size() < (size_t) k; ++i) {
+            const llama_token t = idx[i];
+            std::string piece = token_piece(vocab, t);
+            if (piece.empty() || !is_complete_utf8(piece)) {
+                continue;  // control token or part of a character
+            }
+            out.push_back(NextToken{t, std::move(piece), lsm[(size_t) t]});
+        }
+        if (out.size() == (size_t) k || width == (size_t) n_vocab) {
+            break;
+        }
+        width = std::min<size_t>((size_t) n_vocab, width * 4);
+    }
+    return out;
+}
+
+EvalStats last_eval_stats() {
+    return g_stats;
+}
+
+} // namespace cliffword
diff --git a/node_modules/llama.rn/cpp/jsi/CliffwordScore.h b/node_modules/llama.rn/cpp/jsi/CliffwordScore.h
new file mode 100644
index 0000000..73c273c
--- /dev/null
+++ b/node_modules/llama.rn/cpp/jsi/CliffwordScore.h
@@ -0,0 +1,99 @@
+// Cliffword (patch-package, app/patches/llama.rn+0.13.0-rc.11.patch): log-probabilities of a
+// supplied text, which llama.rn has no call for.
+//
+// Plain llama.cpp C API only, no JSI and no rn-llama types, so the same file builds in the
+// app (cpp/jsi is compiled from source on iOS and Android) and on a desktop against
+// vendor/llama.cpp (app/native-tests/scoring). Every llama_* symbol used here is exported by
+// the prebuilt rnllama libraries (checked with nm, see app/native-tests/scoring/README.md).
+//
+// Semantics follow proof/model_server.py and proof/score.py exactly:
+// - start token: what tokenizing "" with add_special adds (BOS when the model adds one),
+//   else the end-of-text token llama_vocab_eos (<|im_end|>, 151645, for the Qwen3 GGUFs);
+// - the context and the text are tokenized separately, without special tokens or BOS;
+// - one sequence start + context + text is evaluated in seq 0, with logits for every
+//   position that predicts a text token; log-softmax over the raw logits in double.
+#pragma once
+
+#if defined(RNLLAMA_USE_FRAMEWORK_HEADERS)
+#include <rnllama/llama.h>
+#else
+#include "llama.h"
+#endif
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace cliffword {
+
+// One token of the scored text.
+struct ScoredToken {
+    llama_token id;
+    // Byte range of the token's piece in the UTF-8 of the text. A piece may end inside a
+    // multi-byte character; callers merge such tokens with the next (model_server.py).
+    size_t byte_start;
+    size_t byte_end;
+    // Natural log of P(token | start + context + previous text tokens). May be -inf.
+    double logprob;
+};
+
+// One candidate next token.
+struct NextToken {
+    llama_token id;
+    // The token's piece: non-empty and complete, well-formed UTF-8.
+    std::string piece;
+    double logprob;
+};
+
+// What seq 0 of the context's memory holds, as far as these functions know. The caller keeps
+// one per llama_context and must reset it (and clear the memory) whenever anything else may
+// have changed the memory. On return it describes the memory again; after a failure it is
+// empty and the memory is cleared.
+struct EvalState {
+    // Tokens at positions 0..n-1 of seq 0.
+    std::vector<llama_token> tokens;
+    // Positions [0, clean) were evaluated in batches of at least kMinBatch tokens, so they can
+    // be reused without changing a score (see evaluate() in CliffwordScore.cpp).
+    size_t clean = 0;
+};
+
+// Smallest batch evaluated. In the llama.cpp builds the proof used, a one-token batch takes
+// another CPU kernel path and moved logprobs by up to 0.28 nats; batches of two or more
+// reproduce a single full batch (proof/model_server.py, ModelServer.logits).
+constexpr size_t kMinBatch = 2;
+
+// Start tokens: BOS (and whatever else add_special adds) or, if none, {llama_vocab_eos}.
+std::vector<llama_token> start_tokens(const llama_vocab * vocab);
+
+// Tokens of `text` without special tokens and without BOS (parse_special = false).
+std::vector<llama_token> tokenize(const llama_vocab * vocab, const std::string & text);
+
+// Raw bytes of a token's piece (special tokens render as nothing, like llama-cpp-python's
+// detokenize). May be a partial UTF-8 sequence.
+std::string token_piece(const llama_vocab * vocab, llama_token token);
+
+// True when `bytes` is well-formed, complete UTF-8 (the rule of Python's bytes.decode("utf-8"):
+// no overlongs, surrogates, values above U+10FFFF or cut sequences). "" is complete.
+bool is_complete_utf8(const std::string & bytes);
+
+// Per-token log-probabilities of `text` after start + `context`. An empty text gives no
+// tokens. Throws std::runtime_error when the sequence does not fit the context window, when
+// llama_decode fails or when the context computes no logits (an embedding context).
+std::vector<ScoredToken> score_text(llama_context * ctx, EvalState & state,
+                                    const std::string & context, const std::string & text);
+
+// The k most likely next tokens after start + `context`, most likely first (raw softmax, no
+// sampling). Tokens whose piece is empty (control tokens) or only part of a UTF-8 character
+// are skipped and do not count towards k, as in model_server.py's /next.
+std::vector<NextToken> next_tokens(llama_context * ctx, EvalState & state,
+                                   const std::string & context, int k);
+
+// Counters from the last score_text / next_tokens call on this thread (for tests and logs).
+struct EvalStats {
+    size_t prefix_tokens = 0;   // start + context tokens
+    size_t reused_tokens = 0;   // positions taken from the memory instead of evaluated
+    size_t evaluated_tokens = 0;
+};
+EvalStats last_eval_stats();
+
+} // namespace cliffword
