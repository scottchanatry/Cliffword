+#include <unordered_map>
 #include <utility>
 #include <vector>
 
@@ -550,6 +552,183 @@ namespace rnllama_jsi {
         return reinterpret_cast<rnllama::llama_rn_context*>(ctxPtr);
     }
 
+    // ---- Cliffword (patch-package: app/patches/llama.rn+0.13.0-rc.11.patch) ----------------
+    // llamaCliffwordScoreText(contextId, contextText, text) and
+    // llamaCliffwordNextTokens(contextId, contextText, k): the log-probability of every token
+    // of a supplied text, and the k most likely next tokens, computed by
+    // cpp/jsi/CliffwordScore.cpp on the completion's sequence (seq 0).
+    //
+    // Each call runs on the thread pool through createPromiseTask and holds a ContextClaim for
+    // its whole run, like embedding() and decide(), so it never overlaps a completion or any
+    // other op on the context: an overlapping op fails with "Context is busy".
+    //
+    // The memory of seq 0 is shared with the completion, which records what that memory holds
+    // in completion->embd[0, n_past) and reuses the longest shared prefix for its next prompt
+    // (loadPrompt). A call therefore
+    //   - reuses its own previous evaluation (the shared context of several scored texts) only
+    //     while embd / n_past still hold exactly the tokens it left there, i.e. nothing else
+    //     ran since; otherwise it first calls clearCache(false), which clears the memory and
+    //     resets embd, n_past and the prompt state checkpoints;
+    //   - afterwards records its tokens in embd / n_past, so the next completion treats them
+    //     as its prompt cache (keeping the shared prefix, dropping the rest) and never reuses
+    //     a stale one; after a failure it clears the cache.
+    struct CliffwordSlot {
+        rnllama::llama_rn_context* owner = nullptr;
+        cliffword::EvalState state;
+    };
+    static std::mutex g_cliffwordMutex;
