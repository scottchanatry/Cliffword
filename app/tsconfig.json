{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@cliffword/engine": [
        "../engine/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist-*",
    ".expo",
    "ios",
    "android"
  ]
}
