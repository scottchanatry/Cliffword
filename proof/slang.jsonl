{"id": 10, "street": "Tengo un chin de hambre.", "neutral": "Tengo un poco de hambre.", "region": "DR", "explicit": false}
{"id": 11, "street": "Ahorita vengo, voy pa' la tienda.", "neutral": "Vengo en un momento, voy a la tienda.", "region": "PR", "explicit": false}
{"id": 12, "street": "El corillo está esperando afuera.", "neutral": "El grupo de amigos está esperando afuera.", "region": "PR", "explicit": false}
{"id": 13, "street": "Mi pana, eso 'tá cabrón.", "neutral": "Amigo, eso está increíble.", "region": "PR", "explicit": true}
