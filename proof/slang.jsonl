{"id": 7, "street": "Dímelo, loco, ¿qué lo que?", "neutral": "Dime, amigo, ¿qué tal?", "region": "DR", "explicit": false}
{"id": 8, "street": "Ese carro 'tá to' jevi.", "neutral": "Ese coche está muy bonito.", "region": "PR", "explicit": false}
