{"id": 1, "street": "¿Qué es la que hay, mano?", "neutral": "¿Qué está pasando, amigo?", "region": "PR", "explicit": false}
{"id": 2, "street": "Vamo' a janguear con el corillo esta noche.", "neutral": "Vamos a salir con los amigos esta noche.", "region": "PR", "explicit": false}
{"id": 3, "street": "Esa vaina 'tá brutal.", "neutral": "Esa cosa está increíble.", "region": "PR", "explicit": false}
{"id": 4, "street": "¿Pa' qué tú quieres eso?", "neutral": "¿Para qué quieres eso?", "region": "PR", "explicit": false}
{"id": 5, "street": "Ese pana mío es bien chévere.", "neutral": "Ese amigo mío es muy agradable.", "region": "PR", "explicit": false}
