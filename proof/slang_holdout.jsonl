{"id": 101, "street": "Ese jangueo anoche estuvo brutal.", "neutral": "Esa salida de anoche estuvo increíble.", "region": "PR", "explicit": false}
{"id": 102, "street": "Mi jeva y yo vamos pa' la playa.", "neutral": "Mi novia y yo vamos a la playa.", "region": "PR", "explicit": false}
{"id": 103, "street": "No tengo chavos, mano.", "neutral": "No tengo dinero, amigo.", "region": "PR", "explicit": false}
{"id": 104, "street": "Ese perreo 'tá cabrón.", "neutral": "Ese baile está increíble.", "region": "PR", "explicit": true}
{"id": 105, "street": "Acho, qué revolú hay aquí.", "neutral": "Hombre, qué desorden hay aquí.", "region": "PR", "explicit": false}
{"id": 106, "street": "Llegó el corillo completo.", "neutral": "Llegó todo el grupo de amigos.", "region": "PR", "explicit": false}
{"id": 107, "street": "Dame pon pa'l pueblo.", "neutral": "Llévame al pueblo.", "region": "PR", "explicit": false}
{"id": 108, "street": "¿Qué lo que, manito?", "neutral": "¿Qué tal, hermano?", "region": "DR", "explicit": false}
{"id": 109, "street": "Ese tíguere tiene una jeepeta nueva.", "neutral": "Ese hombre astuto tiene una camioneta nueva.", "region": "DR", "explicit": false}
{"id": 110, "street": "Vamos pa'l colmado.", "neutral": "Vamos a la tienda.", "region": "DR", "explicit": false}
{"id": 111, "street": "Dame un chin de agua.", "neutral": "Dame un poco de agua.", "region": "DR", "explicit": false}
{"id": 112, "street": "Ese bonche estuvo jevi.", "neutral": "Esa fiesta estuvo genial.", "region": "DR", "explicit": false}
