{"id": 117, "street": "Vamos a jamar algo, que tengo hambre.", "neutral": "Vamos a comer algo, que tengo hambre.", "region": "CU", "explicit": false}
{"id": 118, "street": "Ese yuma no habla español.", "neutral": "Ese extranjero no habla español.", "region": "CU", "explicit": false}
{"id": 119, "street": "La fiesta estuvo bárbara.", "neutral": "La fiesta estuvo excelente.", "region": "CU", "explicit": false}
{"id": 120, "street": "Me voy pa'l gao.", "neutral": "Me voy a casa.", "region": "CU", "explicit": false}
