{"id": 114, "street": "¡Coño, qué calor hace!", "neutral": "¡Caramba, qué calor hace!", "region": "DR", "explicit": true}
{"id": 115, "street": "Asere, ¿qué bolá?", "neutral": "Amigo, ¿qué tal?", "region": "CU", "explicit": false}
